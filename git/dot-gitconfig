[user]
  email = defeated@users.noreply.github.com
  name = eddie cianci
[gpg]
  format = ssh
[commit]
  gpgsign = true
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
[push]
  autoSetupRemote = true
	useForceIfIncludes = true
	followTags = true
[pull]
  rebase = true
[rebase]
  autoStash = true
  updateRefs = true
	autoSquash = true
	missingCommitsCheck = error
[fetch]
  prune = true
	writeCommitGraph = true
[submodule]
  recurse = true
[init]
  defaultBranch = main
[include]
  path = ~/.config/git/config
[rerere]
  enabled = true
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
[transfer]
	fsckObjects = true
[column]
	ui = auto
[help]
	autocorrect = prompt
[log]
	date = iso
[branch]
	sort = -committerdate
